# Data (raw/cache are large and re-derivable; splits are committed reproducibility artifacts)
data/raw/
data/cache/

# Models: checkpoints and ONNX exports are gitignored, but the manifest and
# small evaluation plots (not checkpoints) are committed artifacts
models/*
!models/manifest.json
!models/.gitkeep
!models/calibration/
models/calibration/*
!models/calibration/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# TensorBoard / training runs
runs/
lightning_logs/
*.ckpt

# Node / web
web/node_modules/
web/dist/
web/.vite/

# MATLAB: generated binary artifacts (built by build_screening_workflow.m /
# import_models.m), not the scripts that produce them
matlab/*.slx
matlab/*.slx.autosave

# Kaggle
kaggle.json

# Generated artifacts with embedded images (large; reproducible via their scripts)
scripts/clinician_rating_form.html

# OS / editors
.DS_Store
.vscode/
.idea/
.claude/

# Logs
*.log
